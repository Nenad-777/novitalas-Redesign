{
  "buildCommand": "pnpm run build",
  "headers": [
    {
      "source": "/sofia/experiment-0001/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive, nofollow, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/sofia-shift",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive, nofollow, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/talibani-otvorili-vatru-na-protest-za-prava-zena",
      "destination": "/geopolitika/talibani-otvorili-vatru-na-protest-za-prava-zena",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/sofia-shift",
      "destination": "/api/sofia-shift"
    },
    {
      "source": "/sofia/experiment-0001",
      "destination": "/sofia/experiment-0001/index.html"
    },
    {
      "source": "/sofia/experiment-0001/",
      "destination": "/sofia/experiment-0001/index.html"
    },
    {
      "source": "/share/(.*)",
      "destination": "/share/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/sofia-shift.ts": {
      "maxDuration": 90
    }
  }
}
